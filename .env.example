# Copy to .env (git-ignored) and replace every placeholder. Never commit .env.

# --- Postgres container ---
POSTGRES_DB=poultry
POSTGRES_USER=poultry
# Use a long random password, e.g.  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# --- Datasource used by the app (host name "postgres" is the compose service) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/poultry
SPRING_DATASOURCE_USERNAME=poultry
# Must equal POSTGRES_PASSWORD
SPRING_DATASOURCE_PASSWORD=change-me

# --- Security ---
# HS256 signing key, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# PowerShell:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Changing it logs every user out.
APP_SECURITY_JWT_SECRET=replace-with-generated-secret

# --- First run only ---
# Creates the first OWNER when the user table is empty. After the first successful
# start, delete both lines (or leave them empty) and recreate the app container.
APP_BOOTSTRAP_OWNER_USERNAME=owner
APP_BOOTSTRAP_OWNER_PASSWORD=replace-with-strong-password

# --- Frontend access (CORS) ---
# Exact address(es) the web frontend is served from, comma-separated, no wildcards and no trailing slash.
# Leave empty when the frontend is served from the same address as the API (browser then needs no CORS).
APP_CORS_ALLOWED_ORIGINS=

# --- Optional ---
# Host port for the API (default 8080)
#APP_PORT=8080
# JVM flags (default -XX:MaxRAMPercentage=75)
#JAVA_OPTS=-XX:MaxRAMPercentage=75
